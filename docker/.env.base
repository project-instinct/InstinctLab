###
# General settings
###

# Isaac Lab main base image, tagged with the Isaac Lab SHA it was built from
ISAACLAB_BASE_IMAGE=isaac-lab-base:8c9b995cb
# Isaac Sim root inside the base image
DOCKER_ISAACSIM_ROOT_PATH=/isaac-sim
# Isaac Lab path of the base image's editable install
DOCKER_ISAACLAB_PATH=/workspace/isaaclab
# Runtime home and workspace at the host paths (dev-workflow layout)
DOCKER_USER_HOME=/home/leo
DOCKER_INSTINCT_WS_PATH=/home/leo/workspace/instinctlab_ws
